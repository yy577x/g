# Get these from https://my.telegram.org (API development tools)
TG_API_ID=123456
TG_API_HASH=your_api_hash

# Option A: file-based session (persist ./sessions as a volume)
TG_SESSION_NAME=userbot
TG_SESSION_WORKDIR=./sessions

# Option B: session string (recommended for containers) - generate with
# scripts/generate_session_string.py, then set this and leave A's volume out
# TG_SESSION_STRING=

# The userbot account must be an admin of this channel with
# "manage video chats" rights.
TG_CHANNEL=your_channel_username

# Any FFmpeg-readable source: RTMP, HLS (.m3u8), etc.
IPTV_SOURCE_URL=http://example.com/live/stream.m3u8

# Optional: force a transcode if Telegram rejects the raw source as-is
# FFMPEG_SCALE=1280:720
# FFMPEG_FRAMERATE=30

RECONNECT_DELAY_SECONDS=5
